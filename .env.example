# Copy these values into your shell environment. Do not commit a real key.
ARK_API_KEY=replace_me
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-evolving
ARK_API_STYLE=responses
ARK_TIMEOUT_SECONDS=600
ARK_MAX_RETRIES=3
MAX_UPLOAD_MB=8
# Optional: force JSON through a function call. Re-verify after restoring quota.
ARK_FORCE_JSON_TOOL=0
# Optional and disabled by default. Cache only authorised, redacted model outputs.
# ARK_RESPONSE_CACHE_DIR=output/api_cache
